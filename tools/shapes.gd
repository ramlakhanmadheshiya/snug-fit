static func names() -> Array:
	return SHAPES.keys()


static func rows(name: String, mirror: bool = false) -> Array:
	var out: Array = []
	for r: String in SHAPES[name]:
		out.append(r.reverse() if mirror else r)
	return out


static func area(name: String) -> int:
	var n: int = 0
	for r: String in SHAPES[name]:
		n += r.count("#")
	return n


static func cells(shape_rows: Array) -> Array[Vector2i]:
	var out: Array[Vector2i] = []
	for y: int in shape_rows.size():
		var r: String = shape_rows[y]
		for x: int in r.length():
			if r[x] == "#":
				out.append(Vector2i(x, y))
	return out


static func connected(cs: Array[Vector2i]) -> bool:
	if cs.is_empty():
		return false
	var left: Dictionary = {}
	for c: Vector2i in cs:
		left[c] = true
	var stack: Array[Vector2i] = [cs[0]]
	left.erase(cs[0])
	while not stack.is_empty():
		var c: Vector2i = stack.pop_back()
		for d: Vector2i in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
			if left.has(c + d):
				left.erase(c + d)
				stack.append(c + d)
	return left.is_empty()
